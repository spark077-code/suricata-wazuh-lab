# Local custom detection rules (Suricata)

alert icmp any any -> $HOME_NET any (msg:"LOCAL_NET ICMP Ping Sweep Detected"; threshold:type threshold, track by_src, count 10, seconds 5; classtype:attempted-recon; sid:1000005; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LOCAL_NET Internal Port Scan / Rapid Connection Attempt"; tcp.flags:S,CE; threshold:type threshold, track by_src, count 30, seconds 3; classtype:attempted-recon; sid:1000002; rev:1;)

alert tcp any any -> $HOME_NET 22 (msg:"LOCAL_NET Potential SSH Brute Force Attempt"; flow:to_server,established; threshold:type threshold, track by_src, count 5, seconds 60; classtype:successful-admin; sid:1000003; rev:1;)

# SlowLoris - fixed
alert tcp any any -> $HOME_NET 80 (msg:"SLOWLORIS High Connection Rate to HTTP Port"; flow:to_server; flags:S; threshold:type threshold, track by_src, count 20, seconds 10; sid:1000004; rev:2;)

# CUSTOM FLOOD DETECTION - HPING3
alert icmp any any -> $HOME_NET any (msg:"CUSTOM HPING3 ICMP FLOOD DETECTED"; itype:8; content:"HPING3_FLOOD"; threshold:type threshold, track by_src, count 10, seconds 3; classtype:attempted-dos; sid:1000020; rev:1;)

# CUSTOM FLOOD DETECTION - NPING3
alert icmp any any -> $HOME_NET any (msg:"CUSTOM NPING3 ICMP FLOOD DETECTED"; itype:8; content:"NPING3_FLOOD"; threshold:type threshold, track by_src, count 10, seconds 3; classtype:attempted-dos; sid:1000021; rev:1;)
